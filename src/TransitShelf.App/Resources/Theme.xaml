<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    样式与几何令牌（见技术框架设计 8.2）：间距 4/8/12/16，圆角 8/12/18，字号 11/12/13/15。

    这里**不放颜色**。颜色全部来自 Palettes/ 下的配色字典，且一律用 DynamicResource 取，
    这样运行期换配色（托盘「配色」菜单）能立刻生效，不需要重建窗口。
  -->
  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

  <!-- 文字按钮：头部与条目悬停操作 -->
  <Style x:Key="TextButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
            <!-- 不可用时（如空列表的「多选」）要看得出来，否则像是点了没反应 -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
