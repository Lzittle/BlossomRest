# .NET 构建产物
bin/
obj/
artifacts/
publish/
*.user
*.suo
.vs/

# 安装包与可执行文件
*.exe
*.msi
*.msix
*.nupkg

# 工具运行时产生的本地状态与缓存
state.json
state.json.tmp
cache/
*.log

# 本地构建环境（dotnet 用户目录与包缓存，见 scripts/dev.ps1）
.dotnet-home/
.nuget/

# 临时文件
*.tmp
~$*

# 编辑器与系统
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini

# AI agent 的本机工作记忆（不属于产品代码，不入库）
.workbuddy/

# 本机工作区：AI 任务清单、规划、进度记录、内部分析与设计素材，不入公开仓库
workbench/

# 调研原始抓取数据（可由 research/*.ps1 重新生成，不入库）
research/gh-raw*.md
