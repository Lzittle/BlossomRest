<Window x:Class="TransitShelf.App.Views.GroupNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
  <StackPanel Margin="16">
    <Label Content="分组名称" Target="{Binding ElementName=NameBox}"
           Foreground="{DynamicResource PrimaryTextBrush}" Padding="0,0,0,8" />
    <TextBox x:Name="NameBox" Style="{StaticResource NumberBox}" Width="Auto" MaxLength="80"
             AutomationProperties.Name="分组名称" TextChanged="OnNameChanged" />
    <TextBlock Text="最多 80 个字；重名时自动追加编号。" Margin="0,8,0,0" FontSize="11"
               Foreground="{DynamicResource SecondaryTextBrush}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="取消" Style="{StaticResource TextButton}" IsCancel="True" />
      <Button x:Name="SaveButton" Content="保存" Style="{StaticResource TextButton}" IsDefault="True"
              Click="OnSaveClick" IsEnabled="False" />
    </StackPanel>
  </StackPanel>
</Window>
