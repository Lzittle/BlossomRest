<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 必须与被测项目一致：Core 是 net8.0-windows -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- 平台层是 UseWPF 工程（剪贴板走 WPF 的 Clipboard / DataObject） -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- WPF 工程会从隐式引用里去掉 System.IO，既有测试大量使用 Path / File / Directory，这里补回来 -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransitShelf.Core\TransitShelf.Core.csproj" />
    <ProjectReference Include="..\TransitShelf.Platform\TransitShelf.Platform.csproj" />
  </ItemGroup>

</Project>
