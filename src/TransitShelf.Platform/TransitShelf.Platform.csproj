<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>TransitShelf.Platform</RootNamespace>
    <!-- 使用 WPF 的 Clipboard / DataObject；本层是唯一允许接触 Win32 与 UI 相关 API 的层。 -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TransitShelf.Core\TransitShelf.Core.csproj" />
  </ItemGroup>

  <!-- CF_HDROP 内存块的组装是纯函数，交给测试工程直接验证 -->
  <ItemGroup>
    <InternalsVisibleTo Include="TransitShelf.Tests" />
  </ItemGroup>
</Project>
