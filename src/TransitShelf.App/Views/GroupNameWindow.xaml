<Window xmlns:loc="clr-namespace:TransitShelf.App.Localization" x:Class="TransitShelf.App.Views.GroupNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
  <StackPanel Margin="16">
    <Label Content="{loc:Text TD7E266BDC806}" Target="{Binding ElementName=NameBox}"
           Foreground="{DynamicResource PrimaryTextBrush}" Padding="0,0,0,8" />
    <TextBox x:Name="NameBox" Style="{StaticResource NumberBox}" Width="Auto" MaxLength="80"
             AutomationProperties.Name="{loc:Text TD7E266BDC806}" TextChanged="OnNameChanged" />
    <TextBlock Text="{loc:Text T13B75B9DA9DE}" Margin="0,8,0,0" FontSize="11"
               Foreground="{DynamicResource SecondaryTextBrush}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{loc:Text T2CD0F3BE8738}" Style="{StaticResource TextButton}" IsCancel="True" />
      <Button x:Name="SaveButton" Content="{loc:Text TA3030BF8F16D}" Style="{StaticResource TextButton}" IsDefault="True"
              Click="OnSaveClick" IsEnabled="False" />
    </StackPanel>
  </StackPanel>
</Window>
