<Window xmlns:loc="clr-namespace:TransitShelf.App.Localization" x:Class="TransitShelf.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Text T3D2FDA2D0587}"
        Width="520" Height="560"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

  <!--
    独立设置窗口（FR-72 / FR-74 / FR-75，2026-10-08）。

    为什么独立成窗口而不是主面板里的一页或托盘子菜单：
    主面板只有 300×400 且默认收起，塞设置会把"用工具"和"配工具"挤在一起；
    托盘子菜单在上一版实测里点不到、也放不下自定义输入框。
    设置项还会随版本增长，独立窗口是唯一能持续长大的容器。

    外观与浮窗同一套语言：透明窗口 + 自绘圆角（8）+ 实色底（不用亚克力，见 ADR D21），
    配色全部 DynamicResource，跟托盘切换配色联动。
  -->
  <Border CornerRadius="8" BorderThickness="1"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource StrokeBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 标题栏：兼作拖动把手（空白区域按住可移窗口） -->
      <Grid Grid.Row="0" Margin="16,12,8,8">
        <TextBlock Text="{loc:Text TDF3D58C7D84B}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   VerticalAlignment="Center" />
        <Button Content="{loc:Text T3FD47EDCE45B}" Style="{StaticResource TextButton}"
                HorizontalAlignment="Right" Margin="0"
                Click="OnCloseClick" />
      </Grid>

      <!-- 内容区：分组卡片 + ScrollViewer（设置项会增长，先给滚动留位） -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Padding="16,0,12,0">
        <StackPanel Margin="0,0,4,0">

          <Border CornerRadius="8" BorderThickness="1" Padding="14,12" Margin="0,0,0,10"
                  Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource StrokeBrush}">
            <StackPanel>
              <TextBlock Text="{loc:Text T9F6FEE1ABA17}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
              <WrapPanel Margin="0,8,0,0">
                <Button x:Name="AutoLanguageButton" Tag="auto" Content="{loc:Text T217CFE7DB1E3}" Style="{StaticResource TextButton}" Click="OnLanguageClick" />
                <Button x:Name="ChineseLanguageButton" Tag="zh-CN" Content="简体中文" Style="{StaticResource TextButton}" Click="OnLanguageClick" />
                <Button x:Name="EnglishLanguageButton" Tag="en" Content="English" Style="{StaticResource TextButton}" Click="OnLanguageClick" />
              </WrapPanel>
              <TextBlock Text="{loc:Text TD9A7D99966A0}" FontSize="11" TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <!-- 分组一：清理策略（FR-72） -->
          <Border CornerRadius="8" BorderThickness="1" Padding="14,12"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource StrokeBrush}">
            <StackPanel>
              <TextBlock Text="{loc:Text TBACF8C4F7FFE}" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource PrimaryTextBrush}" />
              <TextBlock Text="{loc:Text T9FE27CB4BB14}" FontSize="11" Margin="0,2,0,0"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         TextWrapping="Wrap" />

              <!-- 上限：自定义输入 -->
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{loc:Text TC0C92C80DE37}" FontSize="12"
                             Foreground="{DynamicResource PrimaryTextBrush}" />
                  <TextBlock Text="{loc:Text T870CFE52A7F5}"
                             FontSize="11" Margin="0,2,0,0"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBox x:Name="CapacityBox" Style="{StaticResource NumberBox}"
                           KeyDown="OnNumberKeyDown" LostFocus="OnCapacityLostFocus" />
                  <TextBlock Text="{loc:Text T49CCDE43A154}" FontSize="12" Margin="6,0,0,0"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Grid>

              <!-- 过期时长：自定义输入（小时） -->
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{loc:Text TCE3349FFC2BA}" FontSize="12"
                             Foreground="{DynamicResource PrimaryTextBrush}" />
                  <TextBlock Text="{loc:Text T42DA7978846F}"
                             FontSize="11" Margin="0,2,0,0"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBox x:Name="TimeToLiveBox" Style="{StaticResource NumberBox}"
                           KeyDown="OnNumberKeyDown" LostFocus="OnTimeToLiveLostFocus" />
                  <TextBlock Text="{loc:Text T3B6FEFC50FEB}" FontSize="12" Margin="6,0,0,0"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Grid>

              <TextBlock x:Name="RangeHint" FontSize="11" Margin="0,10,0,0"
                         Foreground="{DynamicResource SupportBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- 分组二：退出行为（FR-74） -->
          <Border CornerRadius="8" BorderThickness="1" Padding="14,12" Margin="0,10,0,0"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource StrokeBrush}">
            <StackPanel>
              <TextBlock Text="{loc:Text TFA0ECD5D377E}" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource PrimaryTextBrush}" />
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{loc:Text T9C03083F7CA5}" FontSize="12"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             TextWrapping="Wrap" />
                  <!--
                    风险说明必须常驻：这是一个不可逆的现场丢弃动作，
                    用户不该靠试错才知道下次启动会看到空列表（红线 R4）。
                  -->
                  <TextBlock Text="{loc:Text TEC49EA83A2A0}"
                             FontSize="11" Margin="0,2,0,0"
                             Foreground="{DynamicResource SupportBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox Grid.Column="1" x:Name="ClearOnExitBox"
                          Style="{StaticResource ToggleSwitch}"
                          Checked="OnClearOnExitChanged" Unchecked="OnClearOnExitChanged" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- 分组：启动（FR-73） -->
          <Border CornerRadius="8" BorderThickness="1" Padding="14,12" Margin="0,10,0,0"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource StrokeBrush}">
            <StackPanel>
              <TextBlock Text="{loc:Text T56410FC65314}" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource PrimaryTextBrush}" />
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{loc:Text TDE38B92AD247}" FontSize="12"
                             Foreground="{DynamicResource PrimaryTextBrush}" />
                  <!--
                    状态以注册表为准：这里说明"可在系统里关"，而不是暗示只能在本程序里改。
                    用户从系统设置关掉后，本开关会跟着显示为关。
                  -->
                  <TextBlock Text="{loc:Text TD91FA07BB5B9}"
                             FontSize="11" Margin="0,2,0,0"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox Grid.Column="1" x:Name="StartWithWindowsBox"
                          Style="{StaticResource ToggleSwitch}"
                          Checked="OnStartWithWindowsChanged" Unchecked="OnStartWithWindowsChanged" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- 分组三：界面（FR-75 / FR-73） -->
          <Border CornerRadius="8" BorderThickness="1" Padding="14,12" Margin="0,10,0,0"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource StrokeBrush}">
            <StackPanel>
              <TextBlock Text="{loc:Text T785D65C70FDE}" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource PrimaryTextBrush}" />

              <!-- 工作区 -->
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{loc:Text T38DF957CBE0B}" FontSize="12"
                             Foreground="{DynamicResource PrimaryTextBrush}" />
                  <TextBlock Text="{loc:Text TA6A182E27EBD}"
                             FontSize="11" Margin="0,2,0,0"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             TextWrapping="Wrap" />
                  <!-- 关闭工作区只隐藏入口，不丢弃已有分组 -->
                  <TextBlock x:Name="WorkspaceNote" FontSize="11" Margin="0,2,0,0"
                             Foreground="{DynamicResource SupportBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox Grid.Column="1" x:Name="EnableWorkspaceBox"
                          Style="{StaticResource ToggleSwitch}"
                          Checked="OnEnableWorkspaceChanged" Unchecked="OnEnableWorkspaceChanged" />
              </Grid>

              <!-- 配色：三个选项做成小按钮组，比下拉更好点、也不会误选 -->
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{loc:Text T2AE75E168123}" FontSize="12"
                             Foreground="{DynamicResource PrimaryTextBrush}" />
                  <TextBlock Text="{loc:Text T27534D13173C}"
                             FontSize="11" Margin="0,2,0,0"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="FrappeButton" Content="{loc:Text TA6B75D068032}" Tag="Frappe"
                          Style="{StaticResource TextButton}" Click="OnPaletteClick" />
                  <Button x:Name="DawnButton" Content="{loc:Text TAA0819DFC4D8}" Tag="RosePineDawn"
                          Style="{StaticResource TextButton}" Click="OnPaletteClick" />
                  <Button x:Name="SystemButton" Content="{loc:Text T217CFE7DB1E3}" Tag="System"
                          Style="{StaticResource TextButton}" Click="OnPaletteClick" />
                </StackPanel>
              </Grid>

              <!-- 单击行为（FR-70）：三个互斥选项，加粗标出当前生效项 -->
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{loc:Text TFC641E6743D1}" FontSize="12"
                             Foreground="{DynamicResource PrimaryTextBrush}" />
                  <TextBlock Text="{loc:Text T060F6F2A4DD2}"
                             FontSize="11" Margin="0,2,0,0"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="ByKindButton" Content="{loc:Text T5BA65A74C4E7}" Tag="ByKind"
                          Style="{StaticResource TextButton}" Click="OnClickBehaviorClick" />
                  <Button x:Name="AlwaysOpenButton" Content="{loc:Text T4938F04D947C}" Tag="AlwaysOpen"
                          Style="{StaticResource TextButton}" Click="OnClickBehaviorClick" />
                  <Button x:Name="AlwaysCopyButton" Content="{loc:Text TFA9692CD1A65}" Tag="AlwaysCopy"
                          Style="{StaticResource TextButton}" Click="OnClickBehaviorClick" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- 分组四：自动收录（FR-15，从托盘搬过来） -->
          <Border CornerRadius="8" BorderThickness="1" Padding="14,12" Margin="0,10,0,12"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource StrokeBrush}">
            <StackPanel>
              <TextBlock Text="{loc:Text TB57F49750C84}" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource PrimaryTextBrush}" />
              <TextBlock Text="{loc:Text TA899DE6C4A5A}"
                         FontSize="11" Margin="0,2,0,0"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         TextWrapping="Wrap" />

              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Text T1778C4DF2C6E}" FontSize="12"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" x:Name="WatchDownloadsBox"
                          Style="{StaticResource ToggleSwitch}"
                          Checked="OnWatchChanged" Unchecked="OnWatchChanged" />
              </Grid>

              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Text T1DB5818576F9}" FontSize="12"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" x:Name="WatchWeChatBox"
                          Style="{StaticResource ToggleSwitch}"
                          Checked="OnWatchChanged" Unchecked="OnWatchChanged" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- 底部：状态回显 + 完成 -->
      <Border Grid.Row="2" BorderThickness="0,1,0,0"
              BorderBrush="{DynamicResource StrokeBrush}" Padding="16,10">
        <Grid>
          <TextBlock x:Name="HintText" FontSize="11" VerticalAlignment="Center"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     TextTrimming="CharacterEllipsis" />
          <Button Content="{loc:Text TC0B3FBFF51CC}" Style="{StaticResource TextButton}"
                  HorizontalAlignment="Right" Margin="0"
                  Click="OnCloseClick" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
